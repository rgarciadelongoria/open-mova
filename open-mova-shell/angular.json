{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "apps",
	"projects": {
		"shell": {
			"projectType": "application",
			"root": "apps/shell",
			"sourceRoot": "apps/shell/src",
			"prefix": "mova",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "shell:application:production"
						},
						"development": {
							"target": "shell:application:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "shell:serve-application:development",
						"rebuildDelay": 500,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 0
					}
				},
				"application": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist/shell",
						"index": "apps/shell/src/index.html",
						"browser": "apps/shell/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "apps/shell/tsconfig.app.json",
						"inlineStyleLanguage": "css",
						"assets": [
							{
								"glob": "**/*",
								"input": "apps/shell/src/assets",
								"output": "assets"
							}
						]
					},
					"configurations": {
						"production": {},
						"development": {}
					}
				},
				"serve-application": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "shell:application:production"
						},
						"development": {
							"buildTarget": "shell:application:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				}
			}
		},
		"first-microfrontend": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:class": {
					"skipTests": true
				},
				"@schematics/angular:component": {
					"skipTests": true
				},
				"@schematics/angular:directive": {
					"skipTests": true
				},
				"@schematics/angular:guard": {
					"skipTests": true
				},
				"@schematics/angular:interceptor": {
					"skipTests": true
				},
				"@schematics/angular:pipe": {
					"skipTests": true
				},
				"@schematics/angular:resolver": {
					"skipTests": true
				},
				"@schematics/angular:service": {
					"skipTests": true
				}
			},
			"root": "templates/first-microfrontend",
			"sourceRoot": "templates/first-microfrontend/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "first-microfrontend:esbuild:production"
						},
						"development": {
							"target": "first-microfrontend:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "first-microfrontend:serve-original:development",
						"rebuildDelay": 500,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 0
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "templates/first-microfrontend/src/main.ts",
						"tsConfig": "templates/first-microfrontend/tsconfig.app.json",
						"assets": [],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "first-microfrontend:esbuild:production"
						},
						"development": {
							"buildTarget": "first-microfrontend:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4300
					}
				}
			}
		},
		"second-microfrontend": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:class": {
					"skipTests": true
				},
				"@schematics/angular:component": {
					"skipTests": true
				},
				"@schematics/angular:directive": {
					"skipTests": true
				},
				"@schematics/angular:guard": {
					"skipTests": true
				},
				"@schematics/angular:interceptor": {
					"skipTests": true
				},
				"@schematics/angular:pipe": {
					"skipTests": true
				},
				"@schematics/angular:resolver": {
					"skipTests": true
				},
				"@schematics/angular:service": {
					"skipTests": true
				}
			},
			"root": "templates/second-microfrontend",
			"sourceRoot": "templates/second-microfrontend/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "second-microfrontend:esbuild:production"
						},
						"development": {
							"target": "second-microfrontend:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "second-microfrontend:serve-original:development",
						"rebuildDelay": 500,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 0
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "templates/second-microfrontend/src/main.ts",
						"tsConfig": "templates/second-microfrontend/tsconfig.app.json",
						"assets": [],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "second-microfrontend:esbuild:production"
						},
						"development": {
							"buildTarget": "second-microfrontend:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4400
					}
				}
			}
		}
	},
	"cli": {
		"analytics": false
	}
}
