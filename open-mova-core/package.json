{
  "name": "@open-mova/core",
  "version": "0.2.7",
  "description": "Contratos y utilidades Angular compartidas de Open Mova",
  "license": "MIT",
  "author": "Open Mova contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgarciadelongoria/open-mova.git",
    "directory": "open-mova-core"
  },
  "bugs": {
    "url": "https://github.com/rgarciadelongoria/open-mova/issues"
  },
  "homepage": "https://github.com/rgarciadelongoria/open-mova#readme",
  "keywords": [
    "angular",
    "capacitor",
    "dependency-injection",
    "microfrontends",
    "open-mova"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote-components": {
      "types": "./dist/remote-components.d.ts",
      "import": "./dist/remote-components.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.json",
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.23"
  },
  "devDependencies": {
    "@angular/compiler-cli": "21.2.23",
    "@angular/core": "^21.2.23",
    "typescript": "^5.9.3"
  }
}
